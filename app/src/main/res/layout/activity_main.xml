<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:text="@string/engine" />
            <Spinner
                android:id="@+id/engineSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/sonioxKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/soniox_key_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted"
                android:maxLines="1" />

            <EditText
                android:id="@+id/openaiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/openai_key_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/get_key"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp" />

            <TextView android:id="@+id/modeLabel" style="@style/Label" android:text="@string/mode" />
            <Spinner
                android:id="@+id/modeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/Label" android:text="@string/audio_source" />
            <Spinner
                android:id="@+id/sourceAudioSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_audio_note"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/languageLabel"
                style="@style/Label"
                android:text="@string/languages_one_way" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <Spinner
                    android:id="@+id/sourceSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/langArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/brand"
                    android:textSize="20sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Spinner
                    android:id="@+id/targetSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/twoWayNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/two_way_note"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:paddingTop="4dp"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ttsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/speak_translation"
                android:textColor="@color/on_surface"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/ttsSpeedLabel"
                style="@style/Label"
                android:text="@string/tts_speed" />
            <SeekBar
                android:id="@+id/ttsSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/overlaySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/floating_subtitles"
                android:textColor="@color/on_surface"
                android:paddingTop="4dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/refineSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/deepseek_refine"
                android:textColor="@color/on_surface"
                android:paddingTop="4dp" />

            <EditText
                android:id="@+id/deepseekKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/deepseek_key_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted"
                android:maxLines="1" />

            <EditText
                android:id="@+id/glossaryInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/glossary_hint"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:maxLines="4"
                android:gravity="top"
                android:importantForAutofill="no"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- Quick controls shown only while a session is running (settings hidden). -->
    <LinearLayout
        android:id="@+id/liveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/liveTtsSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voice_short"
            android:textColor="@color/on_surface" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/liveOverlaySwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/overlay_short"
            android:textColor="@color/on_surface" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/translationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/translation_text"
                android:textSize="26sp"
                android:textIsSelectable="true"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/provisionalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textStyle="italic"
                android:textSize="22sp"
                android:paddingTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/sourceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/source_text"
                android:textSize="16sp"
                android:textIsSelectable="true"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/startStopButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start"
            android:backgroundTint="@color/brand"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/clearButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/clear" />
    </LinearLayout>

</LinearLayout>
